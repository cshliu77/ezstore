# EZStore Agent 本機開發設定（複製為 .env 後填入）
# 模型憑證（二選一）
# A. Google AI Studio API key（建議）：https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# B. Vertex AI：先 `gcloud auth application-default login`，再把上面兩行換成下面三行
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# 選用：把 OpenTelemetry 送到 Cloud Trace（需 uv add "google-adk[otel-gcp]"）
# OTEL_TO_CLOUD=true

# 模型（AI Studio 免費方案可用）
AGENT_MODEL=gemini-3.8-flash

# MCP Server（本機開發用 localhost；Docker Compose 內為 http://mcp-server:8000/mcp）
MCP_URL=http://localhost:8000/mcp

# 前端網址（回覆中的系統連結會用到）與允許的 CORS 來源
FRONTEND_URL=http://localhost:3000
ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
